# Copy to config/mcp-env/ise.env (gitignored) and fill in. Read by
# scripts/00-preflight.sh (Marketplace terms check) and by the ISE
# az-CLI bring-up scripts. ISE deploys by az CLI, not Terraform. ADR 0003.

# Confirmed against the Azure Marketplace on 2026-09-12 (TrustSec Phase 1,
# Task 1). "cisco-ise_3_4" is both the SKU and the Marketplace plan name.
ISE_IMAGE_PUBLISHER=cisco
ISE_IMAGE_OFFER=cisco-ise-virtual
ISE_IMAGE_SKU=cisco-ise_3_4
ISE_IMAGE_VERSION=latest

# Documented ISE-on-Azure evaluation size. Draws on the regional vCPU
# quota, not the Edsv6 family the CML host uses. Raise it if the eval
# outgrows this size.
ISE_VM_SIZE=Standard_D8s_v4

# Static address on the routed transit network from ADR 0003.
ISE_PRIVATE_IP=10.20.2.20
