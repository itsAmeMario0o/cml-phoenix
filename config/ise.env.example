# Copy to config/mcp-env/ise.env (gitignored) and fill in. Read by
# scripts/00-preflight.sh (Marketplace terms check) and by the ISE
# az-CLI bring-up scripts. ISE deploys by az CLI, not Terraform. ADR 0003.

# Confirmed against the Azure Marketplace on 2026-09-12 (TrustSec Phase 1).
# "cisco-ise_3_5" is both the SKU and the Marketplace plan name, and the
# image terms are already accepted on the subscription. A fresh 3.5 deploy
# starts a fresh 90-day evaluation.
ISE_IMAGE_PUBLISHER=cisco
ISE_IMAGE_OFFER=cisco-ise-virtual
ISE_IMAGE_SKU=cisco-ise_3_5
ISE_IMAGE_VERSION=latest

# Documented ISE-on-Azure evaluation size. Draws on the regional vCPU
# quota, not the Edsv6 family the CML host uses. Raise it if the eval
# outgrows this size.
ISE_VM_SIZE=Standard_D8s_v4

# Static address on the routed transit network from ADR 0003.
ISE_PRIVATE_IP=10.20.2.20

# Hostname ISE gives itself, from the custom-data file at first boot.
# Required (load_ise_env), not a secret, so it stays uncommented here
# with the other required keys.
ISE_HOSTNAME=ise-lab

# --- Secrets below: fill these in only in config/mcp-env/ise.env, never
# here. ADR 0004, the same no-secret-in-a-tracked-file pattern as
# config/cml.tfvars. scripts/25-ise-up.sh and scripts/lib/ise-userdata.sh
# read them; scripts/45-ise-down.sh needs none of them.

# ISE's own web/CLI admin password, set at first boot through the
# Azure custom-data file (never on an az command line, never committed).
# ISE_ADMIN_PASSWORD=CHANGE-ME-not-a-real-password

# RADIUS shared secret between ISE and the C8000v lab edge (the transit
# bridge NAD, ADR 0003). Also placed in config/labs.env for the lab
# topology's aaa configuration; never a real secret in either file here.
# RADIUS_SECRET=CHANGE-ME-not-a-real-secret
