# Copy to config/mcp-env/ise.env (gitignored) and fill in. ISE is deployed
# by hand through the Azure Marketplace portal, per
# docs/ISE-AD-BUILD.md (Part 2) (ADR 0008 amendment). The values below are
# what to type into that wizard and what scripts/25-ise-up.sh --post-deploy
# reads afterward, with one exception: the wizard's password is a first-boot
# value that ISE forces you to change at the first login, and that change is
# where ISE_ADMIN_PASSWORD gets set.

# Read by scripts/00-preflight.sh to confirm the Marketplace terms are
# accepted on the subscription before you go deploy by hand.
ISE_IMAGE_PUBLISHER=cisco
ISE_IMAGE_OFFER=cisco-ise-virtual
ISE_IMAGE_SKU=cisco-ise_3_5

# ISE_HOSTNAME, ISE_PRIVATE_IP: what you type into the wizard's Basics and
# Network Settings tabs, and what scripts/25-ise-up.sh --post-deploy uses
# afterward to name the NIC (<hostname>nic) and OS disk (<hostname>osdisk)
# the wizard created, and to reach ISE for its readiness check.
ISE_HOSTNAME=ise1
ISE_PRIVATE_IP=10.20.2.20

# The only source allowed to reach the ISE admin ports (443, 22): the CML
# host, since all operator access is through the CML jump (ADR 0003, 0008).
ISE_ADMIN_SOURCE_CIDR=10.20.1.10/32

# --- Secrets below: set only in config/mcp-env/ise.env, never here. ADR 0004.
# The iseadmin GUI/CLI password. ISE policy: 6-25 chars, upper+lower+number,
# no "iseadmin"/"cisco", specials only from @~*!,+=_-.
# ISE_ADMIN_PASSWORD=CHANGE-ME-not-a-real-password
# RADIUS shared secret with the C8000v edge NAD.
# RADIUS_SECRET=CHANGE-ME-not-a-real-secret
