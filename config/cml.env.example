# What scripts/20-up.sh writes to config/mcp-env/cml.env (gitignored,
# mode 0600) after a build. Nothing to copy or fill in; this file only
# documents the keys. Read by every script through load_cml_env in
# scripts/lib/common.sh and by scripts/mcp-cml.sh for cml-mcp.

# The controller's public address. For the browser and for humans. No
# script dials it (ADR 0012).
CML_URL=https://<public ip>

# The "cml" forward from config/tunnels.conf, started by
# scripts/50-tunnels.sh up: local 9443 to the controller's own 443 inside
# the pinned SSH session. This is what every script and cml-mcp dial, and
# load_cml_env refuses to run while it is not listening. Change the port
# here and in tunnels.conf together.
CML_API_BASE=https://127.0.0.1:9443

CML_USERNAME=admin
# The persistent root's app_admin_password output. 20-up.sh fills it;
# never type it here or anywhere tracked.
CML_PASSWORD=

# Applies to the loopback leg above only. The URL names 127.0.0.1 and the
# controller's self-signed certificate does not, so hostname verification
# could never pass there; the internet leg is the SSH host key in
# keys/known_hosts (ADR 0012).
CML_VERIFY_SSL=false
