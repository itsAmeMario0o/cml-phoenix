# Copy to config/mcp-env/labs.env (gitignored) and set real values.
# Read by scripts/60-import-lab.sh, which fills every __NAME__ in a
# topology under labs/ from the variable NAME here, and by
# scripts/mcp-cml.sh, which hands LAB_PASSWORD to cml-mcp for device
# logins. ADR 0006.
#
# Every lab: the NX-OS admin user, the IOS XE admin user, the FTDv admin,
# and the Ubuntu users all get this. FTD enforces complexity: at least
# eight characters with upper case, lower case, and a digit.
LAB_PASSWORD=change-me

# labs/ftdv-cluster.yaml only. From Security Cloud Control, onboard a
# device with the CLI registration key method; the generated
# "configure manager add" line carries these three values in order.
# Leave them unset for labs that do not reference them.
CDFMC_HOST=
CDFMC_REG_KEY=
CDFMC_NAT_ID=
