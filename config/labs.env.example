# Copy to config/mcp-env/labs.env (gitignored) and set real values.
# Read by scripts/60-import-lab.sh, which fills every __NAME__ in a
# topology under labs/ from the variable NAME here, and by
# scripts/mcp-cml.sh, which hands LAB_PASSWORD to cml-mcp for device
# logins. ADR 0006.
#
# Every lab: the NX-OS admin user, the IOS XE admin user, and the Ubuntu
# users get this. The FTDv admin has its own value below.
LAB_PASSWORD=change-me

# labs/ftdv-cluster.yaml only. Threat Defense rejects a day-0 admin
# password without a special character and then refuses to configure
# anything, including the cdFMC registration, until the password is
# changed at the console. So the FTDv admin gets its own value: at least
# eight characters with upper case, lower case, a digit, and one of
# @#*-_+!, no run of three repeated characters, no simple sequence such
# as 1234 or abcd. Seen 2026-09-10.
FTD_ADMIN_PASSWORD=

# labs/ftdv-cluster.yaml only. In Security Cloud Control, onboard two
# threat defense devices named ftd1 and ftd2 with the CLI registration
# key method. Each generates its own "configure manager add HOST KEY NATID"
# line: the host is the same for both, the key and NAT ID are per device.
# Leave these unset for labs that do not reference them.
CDFMC_HOST=
CDFMC_REG_KEY_FTD1=
CDFMC_NAT_ID_FTD1=
CDFMC_REG_KEY_FTD2=
CDFMC_NAT_ID_FTD2=
