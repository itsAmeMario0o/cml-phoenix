# Copy to config/mcp-env/labs.env (gitignored) and set real values.
# Read by scripts/60-import-lab.sh, which fills every __NAME__ in a
# topology under labs/ from the variable NAME here, by scripts/mcp-cml.sh,
# which hands LAB_PASSWORD to cml-mcp for device logins, and by
# scripts/70-users.sh, which reads LAB_USER_PASSWORD. ADR 0006, ADR 0007.
#
# Every lab: the NX-OS admin user, the IOS XE admin user, and the Ubuntu
# users get this. The FTDv admin has its own value below.
LAB_PASSWORD=change-me

# scripts/70-users.sh only. The password every CML user account gets, so
# one string covers everyone and you share it offline. Leave it empty to
# generate a random password per user instead. CML wants at least 8
# characters and rejects common passwords, so "labpass1" works but
# "12345678" and "password" do not.
LAB_USER_PASSWORD=

# labs/ftdv-cluster.yaml only. Threat Defense rejects a day-0 admin
# password without a special character and then refuses to configure
# anything, including the cdFMC registration, until the password is
# changed at the console. So the FTDv admin gets its own value: at least
# eight characters with upper case, lower case, a digit, and one of
# @#*-_+!, no run of three repeated characters, no simple sequence such
# as 1234 or abcd. Seen 2026-09-10.
FTD_ADMIN_PASSWORD=

# labs/ftdv-cluster.yaml only. In Security Cloud Control, onboard two
# threat defense devices named ftd1 and ftd2 with the CLI registration
# key method. Each generates its own "configure manager add HOST KEY NATID"
# line: the host is the same for both, the key and NAT ID are per device.
# Leave these unset for labs that do not reference them.
CDFMC_HOST=
CDFMC_REG_KEY_FTD1=
CDFMC_NAT_ID_FTD1=
CDFMC_REG_KEY_FTD2=
CDFMC_NAT_ID_FTD2=

# labs/trustsec-phase1.yaml only. ISE runs outside CML, as a disposable
# VM on the apps subnet, so its address comes from that build (see
# terraform/ise once it exists) rather than from this lab. RADIUS_SECRET
# is the shared key between the cat8000v edge and ISE, used for both the
# RADIUS authentication and the dynamic-author (CoA) client; it must
# match the key on the matching network device entry in ISE, or RADIUS
# and CoA both fail with a shared-secret mismatch.
ISE_IP=
RADIUS_SECRET=

# verify/trustsec-phase1 pyATS run only (ADR 0009). A throwaway, rotatable
# ISE test identity for the edge's `test aaa` check. Export these before the
# live verification run; never a real user's credential, since the test
# command puts the password in cleartext in the pyATS archive. Set in the
# gitignored config/mcp-env/labs.env, never here.
# TRUSTSEC_TEST_USERNAME=
# TRUSTSEC_TEST_PASSWORD=

# TrustSec Phase 2, Act 1 (docs/specs/2026-09-17-trustsec-phase2-design.md).
# sw1 answers ISE's SNMP polling with v3 authPriv and sends traps with v2c.
# The same values go on the switch and on the ISE network device entry.
# Set in the gitignored config/mcp-env/labs.env, never here.
# SNMP_V3_USER=ise-poll
# SNMP_V3_AUTH_PASSWORD=
# SNMP_V3_PRIV_PASSWORD=
# SNMP_RO_COMMUNITY=

# Splunk Enterprise as a CML container (roadmap item 23, Cisco's
# refplat-*-splunk.iso from CiscoLearning/cml-docker-containers). The web
# UI's admin password, set at the container's first boot. 60-day trial;
# a rebuilt container starts the clock again. Set in the gitignored
# config/mcp-env/labs.env, never here.
# SPLUNK_ADMIN_PASSWORD=
