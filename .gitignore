# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
vendor/cloud-cml/.terraform.lock.hcl

# Rendered config and secrets
config/cml.yml
config/mcp-env/*
!config/mcp-env/.gitignore
.envrc
*.pem
*.key

# OS and editor
.DS_Store
.idea/
.vscode/

# CML software lives in software/ and is never committed. The folder keeps
# only its own .gitignore and README. See docs/PREREQUISITES.md.
software/*
!software/.gitignore
!software/README.md
*.iso
*.pkg
*.qcow2

# Generated by scripts, never committed
.preflight-ok
.preflight-ok.saved
.cml-tunnels/
.refplat-mount/
.azcopy/
tests/.tmp*/
keys/*
!keys/.gitignore
exports/*
!exports/.gitignore
config/tunnels.conf

# Python bytecode from the test suite
__pycache__/
