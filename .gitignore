# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
vendor/cloud-cml/.terraform.lock.hcl

# Rendered config and secrets
config/cml.yml
config/mcp-env/*
!config/mcp-env/.gitignore
.envrc
*.pem
*.key

# OS and editor
.DS_Store
.idea/
.vscode/

# CML software lives in software/ and is never committed. The folder keeps
# only its own .gitignore and README. See docs/PREREQUISITES.md.
software/*
!software/.gitignore
!software/README.md
*.iso
*.pkg
*.qcow2

# Generated by scripts, never committed
.preflight-ok
.cml-tunnels/
.refplat-mount/
.azcopy/
tests/.tmp*/
config/tunnels.conf

# keys/ and exports/ carry their own "ignore everything but .gitignore"
# nested .gitignore, the same pattern software/ and config/mcp-env/ use.

# Python bytecode from the test suite
__pycache__/

# pyATS verification layer (ADR 0009): the venv and generated testbeds,
# plus easypy's archive and runinfo, which scripts/80-verify-lab.sh keeps
# here so nothing is written outside the repo. The archive can hold the
# test AAA password in clear text.
verify/.venv/
verify/.testbed/
verify/.archive/
verify/.runinfo/
