# Bootstrap root: local state. Creates the storage that holds every other
# root's state, so it cannot use blob state itself. ADR 0002.
terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}
