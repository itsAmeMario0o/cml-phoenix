# AD root: one disposable Windows Server domain controller for the ISE
# session. Local state, session lifetime, destroyed after ISE. ADR 0010.
terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}
